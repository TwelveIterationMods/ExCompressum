{
  "schemaVersion": 1,
  "id": "excompressum",
  "version": "${version}",

  "name": "Ex Compressum",
  "description": "Ex Nihilo Addon. Attempts to reduce grind by adding pre-automation tools like compressed hammers.",
  "authors": [
    "BlayTheNinth"
  ],
  "contact": {
    "homepage": "https://mods.twelveiterations.com/mc/ex-compressum",
    "sources": "https://github.com/TwelveIterations/ExCompressum",
    "issues": "https://github.com/TwelveIterations/ExCompressum/issues"
  },

  "license": "All Rights Reserved",
  "icon": "excompressum-icon.png",

  "environment": "*",
  "entrypoints": {
    "main": [
      "net.blay09.mods.excompressum.fabric.FabricExCompressum"
    ],
    "client": [
      "net.blay09.mods.excompressum.fabric.client.FabricExCompressumClient"
    ],
    "fabric-datagen": [
      "net.blay09.mods.excompressum.fabric.datagen.ModDataGenerator"
    ],
    "modmenu": [
      "net.blay09.mods.excompressum.fabric.compat.ModMenuIntegration"
    ],
    "jade": [
      "net.blay09.mods.excompressum.fabric.compat.jade.FabricJadeExCompressumPlugin"
    ],
    "jei_mod_plugin": [
      "net.blay09.mods.excompressum.compat.jei.JEIAddon"
    ]
  },
  "mixins": [
    "excompressum.mixins.json"
  ],
  "depends": {
    "balm-fabric": ">=7.0.0",
    "fabricloader": ">=0.14.21",
    "fabric": "*",
    "minecraft": ">=1.20",
    "java": ">=17"
  },
  "suggests": {
    "modmenu": "*"
  },
  "custom": {
    "modmenu": {
      "links": {
        "modmenu.discord": "https://discord.gg/VAfZ2Nau6j"
      }
    }
  }
}